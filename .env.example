# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" (sin ".example") NO se sube a control de versiones.

# Clave que deben enviar los clientes en el header X-API-Key.
SMS_API_KEY=cambia-esto-por-una-clave-secreta

# Usuario y password para entrar al dashboard web (GET /). El login los
# valida contra estos dos valores y, si coinciden, le entrega SMS_API_KEY
# al navegador para las llamadas siguientes.
#
# OPCIONAL: si dejas estas dos lineas vacias o comentadas, el dashboard NO
# pide login (util para una PC dedicada a un solo router, de uso interno).
DASHBOARD_USER=cambia-este-usuario
DASHBOARD_PASSWORD=cambia-esta-password

# Limpieza automatica (opcional, estos son los valores por defecto; 0 = no limpiar):
# - MAX_MESSAGES_DB: cuantos envios se conservan en el historial de
#   sms_gateway.db por router; los mas antiguos se borran solos.
# - MAX_SMS_MODEM: si la memoria del modem llega a este numero de SMS, se
#   vacia antes del siguiente envio (el MF920V guarda 100 y lleno deja de enviar).
MAX_MESSAGES_DB=50
MAX_SMS_MODEM=50
# - MAX_QUEUE_MODEM: los envios a un mismo modem salen de a uno; cuantos pueden
#   esperar turno. Si hay mas, la API responde 503 ("modem ocupado") al instante
#   en vez de acumularlos y dejar de responder.
MAX_QUEUE_MODEM=20

# Los routers (ip, password, numero) NO se configuran aca: se administran
# desde el dashboard web (abrir http://localhost:8000/ con la API corriendo)
# o por la API (PUT /routers/<id>), y quedan guardados en sms_gateway.db.
#
# Las variables ZTE_ROUTER_PASSWORD / ZTE_PASSWORD_<ID> de abajo solo se
# usan una vez, y solo si estas migrando un routers.json de una instalacion
# anterior de este proyecto (ver DOCUMENTACION_TECNICA.md, seccion 7).
# Si estas empezando de cero, podes borrar estas dos lineas.

# ZTE_ROUTER_PASSWORD=admin
# ZTE_PASSWORD_ROUTER2=otra-password
